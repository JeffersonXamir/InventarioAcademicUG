<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:text="@string/title_detail"
            android:textColor="@color/ug_blue"
            android:textSize="@dimen/title_size"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDetalleNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="@string/hint_nombre"
            android:inputType="text"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etDetalleCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="@string/hint_categoria"
            android:inputType="text"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etDetalleCantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="@string/hint_cantidad"
            android:inputType="number"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etDetalleUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="@string/hint_ubicacion"
            android:inputType="text"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etDetalleObservacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:hint="@string/hint_observacion"
            android:inputType="textMultiLine"
            android:lines="3"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnActualizarItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:backgroundTint="@color/ug_blue"
            android:minHeight="@dimen/button_min_height"
            android:text="@string/btn_actualizar"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnEliminarItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_danger"
            android:minHeight="@dimen/button_min_height"
            android:text="@string/btn_eliminar"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>